YPT_URL=
PUBLIC_URL=https://<mac>.<tailnet>.ts.net
PORT=8787
# CLAUDE_BIN defaults to the absolute path of `claude`; set only to override.
# CLAUDE_BIN=/Users/nabils/.local/bin/claude
# Journal (defaults resolve to /opt/homebrew/bin/*; set only to override).
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/bin/ffprobe
# WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# Defaults to ~/.local/share/whisper-cpp/models/ggml-large-v3-turbo-q5_0.bin when that file exists; transcription is off otherwise.
# Set only to use a different ggml model file.
# WHISPER_MODEL=
# Web Push contact; defaults to PUBLIC_URL when it is https, else a placeholder mailto.
# VAPID_SUBJECT=mailto:you@example.com
# Set to 0 to run without the Moment scheduler and media worker (tests do this).
# BM_BACKGROUND=1
