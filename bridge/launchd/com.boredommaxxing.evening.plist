<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.boredommaxxing.evening</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/nabils/.local/bin/uv</string>
    <string>run</string>
    <string>--project</string>
    <string>bridge</string>
    <string>python</string>
    <string>-m</string>
    <string>bridge.jobs</string>
    <string>evening</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/nabils/claude/Boredom-Maxxing</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/nabils/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- claude reads the Pro login from the keychain by $USER; without it: "Not logged in" -->
    <key>USER</key><string>nabils</string>
    <key>LOGNAME</key><string>nabils</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>21</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key><string>/Users/nabils/claude/Boredom-Maxxing/bridge/data/logs/evening.out.log</string>
  <key>StandardErrorPath</key><string>/Users/nabils/claude/Boredom-Maxxing/bridge/data/logs/evening.err.log</string>
</dict>
</plist>
